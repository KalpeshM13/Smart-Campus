# ==============================================================================
# SMART CAMPUS SERVICE MANAGEMENT SYSTEM (SCMS) - BACKEND CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure with your specific deployment credentials.
# Never commit real API secrets, JWT keys, or database credentials to version control.

# ------------------------------------------------------------------------------
# 1. FastAPI Application & Security Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Smart Campus Service Management System"
API_V1_STR="/api"

# Secret key for signing JWT tokens (Generate a secure 256-bit random hex string)
# e.g., openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-256-bit-hex-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas Cloud & Fallback)
# ------------------------------------------------------------------------------
# For MongoDB Atlas Cloud:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For Local MongoDB instance:
# mongodb://localhost:27017
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="smartcampus_db"

# Legacy Relational SQL Database (Retained for migration scripts & rollback verification)
DATABASE_URL="sqlite:///./smart_campus.db"

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (or * for all in development)
# e.g., http://localhost:5173,http://localhost:3000,https://your-frontend.onrender.com
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,*"

# ------------------------------------------------------------------------------
# 4. Service Level Agreement (SLA) Resolution Thresholds (Hours)
# ------------------------------------------------------------------------------
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=72
SLA_HOURS_LOW=120

# ------------------------------------------------------------------------------
# 5. Salesforce Service Cloud Integration (PRD v2.1 System of Record)
# ------------------------------------------------------------------------------
# Set SALESFORCE_ENABLED=true to activate Salesforce Service Cloud synchronization
# Set SALESFORCE_MOCK_MODE=false to connect directly to a live Salesforce Org
SALESFORCE_ENABLED=true
SALESFORCE_MOCK_MODE=false

# Authentication Type: "client_credentials" (Recommended for Connected Apps) or "password"
SALESFORCE_AUTH_TYPE="client_credentials"

# Salesforce OAuth 2.0 Token & Login Endpoints
# For Developer Edition / Production: https://login.salesforce.com
# For Sandbox orgs: https://test.salesforce.com
SALESFORCE_LOGIN_URL="https://login.salesforce.com"

# Your Org's My Domain Instance URL (e.g., https://your-domain.my.salesforce.com)
SALESFORCE_INSTANCE_URL="https://your-org-domain.my.salesforce.com"

# Salesforce Connected App Credentials (OAuth 2.0)
SALESFORCE_CLIENT_ID="your_connected_app_consumer_key"
SALESFORCE_CLIENT_SECRET="your_connected_app_consumer_secret"

# Optional credentials if using SALESFORCE_AUTH_TYPE="password"
SALESFORCE_USERNAME="integration_user@smartcampus.edu"
SALESFORCE_PASSWORD="your_salesforce_password"
SALESFORCE_SECURITY_TOKEN="your_security_token"

# Salesforce REST API Version
SALESFORCE_API_VERSION="v60.0"

# Case Routing & Triage Default Queues
SALESFORCE_ADMIN_REVIEW_QUEUE="Admin_Review_Queue"
SALESFORCE_DEFAULT_CASE_ORIGIN="Web"
