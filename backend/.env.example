# Smart Campus Service Management System - Environment Variables
# Copy this file to .env and configure your production MongoDB Atlas credentials

# FastAPI & Security Settings
PROJECT_NAME="Smart Campus Service Management System"
SECRET_KEY="super-secret-smart-campus-jwt-key-2026-audit-hardened"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas Database Configuration
# For local offline testing: mongodb://localhost:27017
# For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="smartcampus_db"

# Allowed CORS Origins (Comma-separated for multiple domains or * for all)
# Example for production: https://smartcampus.onrender.com,http://localhost:5173
CORS_ORIGINS="*"

# Legacy SQL Database (Retained for idempotent data migration and rollback only)
DATABASE_URL="sqlite:///./smart_campus.db"

# SLA Service Target Defaults (in Hours)
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=72
SLA_HOURS_LOW=120
